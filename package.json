{
  "name": "github-rank-ng",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Rank NG: Nigeria-focused GitHub developer rankings with a global leaderboard.",
  "repository": {
    "type": "git",
    "url": "https://github.com/shazzark/github-rank-ng.git"
  },
  "homepage": "https://shazzark.github.io/github-rank-ng/",
  "bugs": {
    "url": "https://github.com/shazzark/github-rank-ng/issues"
  },
  "author": "shazzark",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "ejsc \"template/*.ejs\" -o web",
    "test": "npm run build && node --test",
    "verify:rankings": "node scripts/verify-rankings.mjs",
    "get:users": "node lib/getUsers.js",
    "get:users:nigeria": "node lib/getUsersNigeria.js",
    "get:users:info": "node lib/getUserInfo.js",
    "get": "npm run get:users && npm run get:users:nigeria && npm run get:users:info",
    "refresh": "npm run build && npm run get && npm run start"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wcj/ejs-cli": "^2.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
