<!doctype html>
<% const pageFile = type === 'nigeria' ? 'users.nigeria.html' : 'index.html'; %>
<% const pageUrl = `https://shazzark.github.io/github-rank-ng/${pageFile}`; %>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> | GitHub Rank NG</title>
    <meta name="description" content="<%= description %>" />
    <meta name="theme-color" content="#f5f7f3" />
    <meta property="og:site_name" content="GitHub Rank NG" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="<%= title %> | GitHub Rank NG" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:url" content="<%= pageUrl %>" />
    <link rel="canonical" href="<%= pageUrl %>" />
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
        --ink: #17231c;
        --muted: #66736b;
        --line: #e3e9e4;
        --paper: #ffffff;
        --canvas: #f5f7f3;
        --green: #087443;
        --green-deep: #075b35;
        --green-pale: #e9f4ed;
        --gold: #d1a33a;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--canvas); color: var(--ink); }
      a { color: inherit; }
      .site-header { max-width: 1180px; margin: 0 auto; padding: 24px 28px 0; }
      .topline { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 750; letter-spacing: -.02em; }
      .brand-mark { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px; background: var(--green); color: #fff; font-size: 16px; }
      .top-note { color: var(--muted); font-size: 12px; }
      .hero { position: relative; overflow: hidden; margin-top: 30px; padding: clamp(28px, 5vw, 58px); border: 1px solid #dfe9e1; border-radius: 18px; background: radial-gradient(circle at 92% 8%, #dceee1 0, transparent 28%), linear-gradient(120deg, #fff 0%, #f8fbf8 75%, #f0f7f1 100%); }
      .eyebrow { display: inline-flex; align-items: center; gap: 9px; margin: 0 0 17px; color: var(--green-deep); font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
      .eyebrow::before { width: 22px; height: 2px; background: var(--gold); content: ""; }
      h1 { max-width: 780px; margin: 0; font-size: clamp(34px, 5.3vw, 58px); line-height: 1.05; letter-spacing: -.055em; }
      .hero-copy { max-width: 650px; margin: 17px 0 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
      .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-top: 28px; }
      .ranking-nav { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
      .ranking-nav a { padding: 9px 14px; border-radius: 7px; color: var(--muted); font-size: 13px; font-weight: 650; text-decoration: none; }
      .ranking-nav a:hover { color: var(--green-deep); }
      .ranking-nav a.active { background: var(--green); color: #fff; }
      .record-count { color: var(--muted); font-size: 12px; white-space: nowrap; }
      .table-tools { display: flex; align-items: center; gap: 10px; padding: 14px 22px; }
      .table-tools label { color: var(--muted); font-size: 12px; font-weight: 650; }
      .table-tools input { width: min(100%, 280px); padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; font: inherit; }
      .table-tools p { margin: 0 0 0 auto; color: var(--muted); font-size: 12px; }
      .pagination { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px; padding: 14px 18px; border-top: 1px solid var(--line); }
      .pagination button { min-width: 36px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 7px; background: #fff; color: var(--ink); cursor: pointer; }
      .pagination button[aria-current="page"] { border-color: var(--green); background: var(--green); color: #fff; }
      .pagination button:disabled { opacity: .45; cursor: not-allowed; }
      .page-indicator { margin-left: 8px; color: var(--muted); font-size: 12px; }
      .empty-search { padding: 20px; color: var(--muted); text-align: center; }
      .find-rank-panel { padding: 18px 22px; border-bottom: 1px solid var(--line); background: linear-gradient(120deg, #fff, #f8fbf8); }
      .find-rank-panel h2 { margin: 0; font-size: 15px; }
      .find-rank-panel > p { margin: 5px 0 12px; color: var(--muted); font-size: 12px; }
      .find-rank-panel label { display: block; margin-bottom: 6px; color: var(--ink); font-size: 12px; font-weight: 650; }
      .find-rank-controls { display: flex; max-width: 520px; gap: 8px; }
      .find-rank-controls input { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; }
      .find-rank-controls button { padding: 10px 16px; border: 0; border-radius: 8px; background: var(--green); color: #fff; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
      .find-rank-controls button:hover { background: var(--green-deep); }
      .find-rank-result { max-width: 720px; margin-top: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
      .find-rank-result h3 { margin: 0 0 8px; font-size: 14px; }
      .find-rank-result p { margin: 5px 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
      .find-rank-profile { display: flex; align-items: center; gap: 10px; }
      .find-rank-profile img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; }
      .find-rank-profile a, .share-rank-link { color: var(--green-deep); font-weight: 700; }
      .contribution-details { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
      .contribution-details h4 { margin: 0 0 8px; font-size: 13px; }
      .contribution-details dl { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 5px 14px; margin: 0; font-size: 12px; }
      .contribution-details dt { color: var(--muted); }
      .contribution-details dd { margin: 0; font-variant-numeric: tabular-nums; font-weight: 650; }
      .rank-match { outline: 3px solid var(--gold); outline-offset: -3px; background: var(--green-pale) !important; }
      main { max-width: 1180px; margin: 0 auto; padding: 24px 28px 48px; }
      .table-panel { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); box-shadow: 0 10px 28px rgb(20 54 33 / 4%); }
      .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 19px 22px; border-bottom: 1px solid var(--line); }
      .panel-heading h2 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: -.01em; }
      .panel-heading p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
      .source-link { color: var(--green); font-size: 12px; font-weight: 650; text-decoration: none; white-space: nowrap; }
      .source-link:hover { text-decoration: underline; }
      .table-scroll { overflow-x: auto; }
      table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; }
      th { padding: 12px 15px; background: #fafcf9; color: #738078; font-size: 10px; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
      td { padding: 13px 15px; border-top: 1px solid #edf0ed; color: #3b4840; font-size: 12px; white-space: nowrap; }
      tbody tr:hover { background: #f8fbf8; }
      td.rank { width: 62px; color: #87938a; font-variant-numeric: tabular-nums; }
      .user-cell { display: flex; min-width: 172px; align-items: center; gap: 10px; }
      .avatar { width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 50%; object-fit: cover; }
      .user-link { color: var(--ink); font-weight: 700; text-decoration: none; }
      .user-link:hover { color: var(--green); text-decoration: underline; }
      .user-name { margin-top: 3px; color: var(--muted); font-size: 11px; }
      .number { color: var(--ink); font-variant-numeric: tabular-nums; font-weight: 700; }
      .site-footer { max-width: 1180px; margin: 0 auto; padding: 0 28px 30px; color: var(--muted); font-size: 11px; line-height: 1.7; }
      .site-footer a { color: var(--green-deep); text-decoration: none; }
      @media (max-width: 640px) {
        .site-header { padding: 16px 15px 0; }
        .top-note { max-width: 150px; text-align: right; }
        .hero { margin-top: 20px; padding: 26px 20px 21px; border-radius: 14px; }
        .hero-copy { font-size: 13px; }
        .hero-foot { align-items: flex-start; flex-direction: column; gap: 11px; margin-top: 20px; }
        .ranking-nav a { padding: 8px 11px; font-size: 12px; }
        main { padding: 16px 15px 34px; }
        .panel-heading { align-items: flex-start; padding: 16px; }
        .find-rank-panel { padding: 16px; }
        .find-rank-controls { flex-direction: column; }
        .find-rank-controls button { min-height: 42px; }
        .contribution-details dl { grid-template-columns: minmax(0, 1fr) auto; gap: 7px 9px; font-size: 11px; }
        .table-tools { align-items: stretch; flex-direction: column; padding: 14px 16px; }
        .table-tools input { width: 100%; }
        .table-tools p { margin: 0; }
        .pagination { gap: 4px; padding: 12px 8px; }
        .pagination button { min-width: 32px; padding: 7px; font-size: 12px; }
        .page-indicator { width: 100%; margin: 4px 0 0; text-align: center; }
        .source-link { font-size: 11px; }
        table { min-width: 0; }
        th, td { padding: 11px 8px; }
        th:nth-child(3), td:nth-child(3),
        th:nth-child(4), td:nth-child(4),
        th:nth-child(6), td:nth-child(6),
        th:nth-child(7), td:nth-child(7) { display: none; }
        th:nth-child(5), td:nth-child(5) { text-align: right; }
        td.rank { width: 38px; }
        .user-cell { min-width: 0; gap: 7px; }
        .avatar { width: 28px; height: 28px; }
        .user-name { display: none; }
        .site-footer { padding: 0 15px 24px; }
      }
      @media (prefers-reduced-motion: no-preference) {
        tbody tr { transition: background-color 120ms ease; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="topline">
        <a class="brand" href="index.html"><span class="brand-mark" aria-hidden="true">⌘</span> GitHub Rank NG</a>
        <span class="top-note">A public directory of developers by GitHub followers</span>
      </div>
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow"><%= type === 'nigeria' ? 'Nigeria developer community' : 'Worldwide developer community' %></p>
        <h1 id="page-title"><%= title %></h1>
        <p class="hero-copy"><%= description %></p>
        <div class="hero-foot">
          <nav class="ranking-nav" aria-label="Developer rankings">
            <a class="<%= type === 'nigeria' ? 'active' : '' %>" href="users.nigeria.html" <%- type === 'nigeria' ? 'aria-current="page"' : '' %>>Nigeria</a>
            <a class="<%= type === 'global' ? 'active' : '' %>" href="index.html" <%- type === 'global' ? 'aria-current="page"' : '' %>>Global</a>
          </nav>
          <span class="record-count"><strong><%= users.length.toLocaleString('en-NG') %></strong> public profiles | Updated <time datetime="<%= RANKING_META.updatedAt %>"><%= new Date(RANKING_META.updatedAt).toLocaleString('en-NG', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }) %> UTC</time></span>
        </div>
      </section>
    </header>
    <main>
